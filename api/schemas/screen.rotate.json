{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "screen.rotate",
  "type": "object",
  "required": [
    "current_screen",
    "total_screens",
    "interval_seconds",
    "widgets"
  ],
  "properties": {
    "current_screen": {
      "type": "integer",
      "minimum": 0
    },
    "total_screens": {
      "type": "integer",
      "minimum": 0
    },
    "interval_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "widgets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "widget_id",
          "origin",
          "dimensions"
        ],
        "properties": {
          "widget_id": {
            "type": "string"
          },
          "origin": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "dimensions": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
