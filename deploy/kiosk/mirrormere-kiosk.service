[Unit]
Description=Mirrormere Wayland Touch Kiosk
After=network-online.target systemd-user-sessions.service
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
Type=simple
User=kiosk
Group=kiosk
SupplementaryGroups=video input audio render
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
Environment="WAYLAND_DISPLAY=wayland-0"
Environment="XDG_SESSION_TYPE=wayland"
Environment="XDG_CURRENT_DESKTOP=cage"
EnvironmentFile=-/etc/default/mirrormere-kiosk
ExecStart=/opt/mirrormere/kiosk/launch.sh
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
