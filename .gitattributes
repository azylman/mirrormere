# Enforce consistent LF line endings across all platforms
* text=auto eol=lf

# Explicitly normalize shell scripts and Go source files
*.sh text eol=lf
*.go text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Makefile text eol=lf

# Mark compiled Vite UI bundles as generated so GitHub / linguist collapses them
web/static/ui/** linguist-generated=true
